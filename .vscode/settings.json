{
  "files.autoSave": "afterDelay",
  "css.autoValidation": "Always",
  "css.styleSheets": ["autoSave"],
  "workbench.sideBar.location": "right",
  "workbench.colorTheme": "Catppuccin Mocha",
  "explorer.confirmDelete": false,
  "workbench.iconTheme": "material-icon-theme",
  "eslint.probe": [
    "astro",
    "civet",
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "mdx",
    "vue",
    "markdown",
    "json",
    "jsonc",
    "glimmer-js",
    "glimmer-ts",
    "svelte",
    "graphql"
  ],
  "editor.formatOnSave": true,
  "editor.fontSize": 16,
  "liveServer.settings.donotShowInfoMsg": true,
  "liveServer.settings.ChromeDebuggingAttachment": true,
  "liveServer.settings.CustomBrowser": "chrome",
  "breadcrumbs.enabled": true,
  "breadcrumbs.icons": true,
  "breadcrumbs.filePath": "off",
  "breadcrumbs.showFiles": true,
  "breadcrumbs.showArrays": true,
  "editor.minimap.enabled": false,
  "editor.wordWrap": "on",

  // Menggunakan tema astro atau catppuccin 

  // Tipografi khas terminal (Gunakan JetBrains Mono atau Fira Code)
  "editor.fontFamily": "FiraCode Nerd Font",
  "editor.fontLigatures": true,
  "editor.lineHeight": 23, 

  // UI Minimalis ala Neovim
  "window.zoomLevel": -1,
  "workbench.activityBar.location": "default",
  "editor.glyphMargin": false,
  "editor.folding": false,
  "editor.lineNumbers": "on", 

  // Pengaturan Kursor Block ala Terminal
  "editor.cursorStyle": "underline",
  "editor.cursorBlinking": "expand",

  // discord
}



